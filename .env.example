# Connection settings read by backend/ and frontend/. Copy the values into your environment;
# never commit a real password.
DATABASE_URL=jdbc:postgresql://localhost:5432/agrosense_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# "always" applies database/schema.sql (and the demo data, where a profile enables it) at startup.
SQL_INIT_MODE=never

# Password given to the demo user created by seed_demo.sql.
SEED_USER_PASSWORD=

# Only needed when an application is not started from its own folder: absolute path of this folder.
# DATABASE_DIR=

# ---------- Backend only ----------

# Secret that signs the login tokens (HS512). Required: the backend refuses to start without a random
# value of at least 64 bytes, for example the output of "openssl rand -base64 64".
JWT_SECRET=
# Minutes a token stays valid after login.
JWT_EXPIRATION_MINUTES=60

# Failed logins allowed per account and per network address before a 15-minute lock; 0 turns a limit off.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_MAX_ATTEMPTS_PER_ADDRESS=20
# LOGIN_LOCK_MINUTES=15

# Origins allowed to call the API and open the WebSocket, separated by commas. Empty allows none.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the AI service that predicts irrigation. Empty turns predictions off.
AI_SERVICE_URL=
# AI_IRRIGATION_PATH=/predict/irrigation
# AI_SERVICE_TIMEOUT_MS=5000
# AI_SERVICE_MAX_ATTEMPTS=1

# MQTT ingestion of sensor readings. Nothing connects unless MQTT_ENABLED=true.
MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=agrosense-backend
MQTT_TOPIC=agrosense/sensors/+/readings
# Leave both empty for a broker without authentication.
MQTT_USERNAME=
MQTT_PASSWORD=
